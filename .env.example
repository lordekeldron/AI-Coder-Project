VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Opcional: Client ID de um GitHub OAuth App para Device Flow
# (conectar sem precisar criar Personal Access Token manualmente)
# Crie em: https://github.com/settings/developers → New OAuth App
# Homepage URL e Callback podem ser http://localhost:3000
VITE_GITHUB_CLIENT_ID=

# Modelo Qwen3-Coder-30B-A3B-Instruct (Hugging Face)
# Repositório: https://huggingface.co/Qwen/Qwen3-Coder-30B-A3B-Instruct
# Token da Hugging Face para chamadas diretas via Hugging Face Router:
# Obtenha gratuitamente em: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=

# Endpoint customizado (opcional, ex: http://localhost:11434/v1/chat/completions para Ollama local ou vLLM)
VITE_QWEN_API_ENDPOINT=

# Nome do modelo (padrão: Qwen/Qwen3-Coder-30B-A3B-Instruct)
VITE_QWEN_MODEL_NAME=Qwen/Qwen3-Coder-30B-A3B-Instruct

